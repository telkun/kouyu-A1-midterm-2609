": [{"sp": "大龙", "hz": "您好！上周日我在这儿买了个台灯，昨天晚上突然坏了。", "py": "Nín hǎo! Shàng zhōurì wǒ zài zhèr mǎile ge táidēng, zuótiān wǎnshang tūrán huài le."}, {"sp": "服务员", "hz": "您带来了吗？我看一下。", "py": "Nín dàilai le ma? Wǒ kàn yíxià."}, {"sp": "大龙", "hz": "给，不知道是哪儿出了毛病。", "py": "Gěi, bù zhīdào shì nǎr chūle máobìng."}, {"sp": "服务员", "hz": "您是希望我们给您修理一下，还是换个新的？", "py": "Nín shì xīwàng wǒmen gěi nín xiūlǐ yíxià, háishi huàn ge xīn de?"}, {"sp": "大龙", "hz": "我怀疑这种灯质量有问题，即便换了新的，还是用不住。", "py": "Wǒ huáiyí zhè zhǒng dēng zhìliàng yǒu wèntí, jíbiàn huànle xīn de, háishi yòng bu zhù."}, {"sp": "服务员", "hz": "不会的，我们超市的产品质量是有保证的，要不然我们也不敢承诺七天之内无条件退换。", "py": "Bú huì de, wǒmen chāoshì de chǎnpǐn zhìliàng shì yǒu bǎozhèng de, yàobùrán wǒmen yě bù gǎn chéngnuò qī tiān zhī nèi wú tiáojiàn tuìhuàn."}, {"sp": "大龙", "hz": "那我要求退货，可以吗？", "py": "Nà wǒ yāoqiú tuì huò, kěyǐ ma?"}, {"sp": "服务员", "hz": "当然可以。您带发票了吗？", "py": "Dāngrán kěyǐ. Nín dài fāpiào le ma?"}, {"sp": "大龙", "hz": "我没有发票，这是我的购物小票。", "py": "Wǒ méiyǒu fāpiào, zhè shì wǒ de gòuwù xiǎopiào."}, {"sp": "服务员", "hz": "请您在这儿登记一下。", "py": "Qǐng nín zài zhèr dēngjì yíxià."}, {"sp": "大龙", "hz": "填好了，给您。", "py": "Tián hǎo le, gěi nín."}, {"sp": "服务员", "hz": "给您钱。对我们给您带来的不便，我感到很抱歉。", "py": "Gěi nín qián. Duì wǒmen gěi nín dàilai de búbiàn, wǒ gǎndào hěn bàoqiàn."}, {"sp": "大龙", "hz": "没关系，这也不是你的错。", "py": "Méi guānxi, zhè yě bú shì nǐ de cuò."}, {"sp": "服务员", "hz": "谢谢您的理解。", "py": "Xièxie nín de lǐjiě."}, {"sp": "大龙", "hz": "我对你们的台灯不满意，但对你们的售后服务还是很满意的。", "py": "Wǒ duì nǐmen de táidēng bù mǎnyì, dàn duì nǐmen de shòuhòu fúwù háishi hěn mǎnyì de."}], "scenarios": [{"title": "场景1：在商店退换鞋", "scenario": "A买了一双鞋，尺码不合适/质量有问题，去找店员B退换。任务：说明退换原因，提出要求。", "aq": ["这双鞋我可以退吗？", "如果不能退，可以换吗？", "需要多长时间？", "可以退钱还是只能换东西？"], "bq": ["您好，请问有什么可以帮您？", "您为什么要退/换？", "您买了几天了？", "您有小票吗？", "您想退货还是换货？", "您想换什么尺码/颜色？"], "ext": ["根据规定，什么情况可以退换？", "如果你们没有我的尺码，怎么办？", "能不能帮我问一下经理？"]}, {"title": "场景2：网购客服", "scenario": "A收到网购的衣服，颜色不对/有质量问题，联系客服B。输出任务：完成在线或电话客服对话。", "aq": ["我收到的衣服颜色不对。"