let state = {
  unit: 1,
  mode: 'vocab',
  showPinyin: false,
  showDlgPinyin: true,
  quiz: { idx: 0, score: 0, answered: false, order: [] },
  sentenceCount: 0,
  scenarioIdx: 0,
};

function getUnit(id) { return UNITS.find(u => u.id === id); }

function loadMistakes() {
  try { return JSON.parse(localStorage.getItem('kouyu_mistakes') || '[]'); }
  catch(e) { return []; }
}
function saveMistakes(arr) {
  try { localStorage.setItem('kouyu_mistakes', JSON.stringify(arr)); } catch(e) {}
}
function addMistake(item) {
  let arr = loadMistakes();
  if (!arr.find(m => m.hanzi === item.hanzi && m.unit === item.unit)) {
    arr.push(item);
    saveMistakes(arr);
  }
}
function removeMistake(idx) {
  let arr = loadMistakes();
  arr.splice(idx, 1);
  saveMistakes(arr);
  render();
}

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function renderUnitTabs() {
  const el = document.getElementById('unitTabs');
  el.innerHTML = UNITS.map(u =>
    `<div class="unit-tab ${u.id === state.unit ? 'active' : ''}" data-unit="${u.id}">Unit ${u.id}<br><span style="font-size:0.7em">${u.title}</span></div>`
  ).join('');
  el.querySelectorAll('.unit-tab').forEach(t => {
    t.addEventListener('click', () => {
      state.unit = parseInt(t.dataset.unit);
      resetQuiz();
      state.scenarioIdx = 0;
      render();
    });
  });
}

function renderModeTabs() {
  document.querySelectorAll('.mode-tab').forEach(t => {
    t.classList.toggle('active', t.dataset.mode === state.mode);
  });
}

function resetQuiz() {
  const u = getUnit(state.unit);
  state.quiz = { idx: 0, score: 0, answered: false, order: shuffle(u.quiz.map((_, i) => i)) };
}

function renderVocab() {
  const u = getUnit(state.unit);
  let html = `<div class="card">
    <div class="toggle-row">
      <button class="btn secondary" id="togglePinyin">${state.showPinyin ? '隐藏拼音' : '显示拼音'}</button>
    </div>
    <div class="vocab-list">`;
  u.vocab.forEach(v => {
    html += `<div class="vocab-row">
      <div class="hz">${v.hz} <span class="pill">${v.pos}</span></div>
      <div class="py ${state.showPinyin ? '' : 'hidden'}">${v.py}</div>
      <div class="en">${v.en}</div>
    </div>`;
  });
  html += `</div></div>`;
  document.getElementById('main').innerHTML = html;
  document.getElementById('togglePinyin').addEventListener('click', () => {
    state.showPinyin = !state.showPinyin;
    renderVocab();
  });
}

function renderQuiz() {
  const u = getUnit(state.unit);
  if (!u.quiz.length) {
    document.getElementById('main').innerHTML = `<div class="card"><div class="empty-state">这个单元没有测验题</div></div>`;
    return;
  }
  if (state.quiz.order.length === 0) resetQuiz();
  if (state.quiz.idx >= state.quiz.order.length) {
    document.getElementById('main').innerHTML = `<div class="card">
      <h2>测验完成！🎉</h2>
      <div class="quiz-score" style="font-size:1.1rem;margin-bottom:14px;">得分：${state.quiz.score} / ${state.quiz.order.length}</div>
      <button class="btn" id="restartQuiz">再测一次</button>
    </div>`;
    document.getElementById('restartQuiz').addEventListener('click', () => { resetQuiz(); renderQuiz(); });
    return;
  }
  const qIdx = state.quiz.order[state.quiz.idx];
  const q = u.quiz[qIdx];
  let html = `<div class="card">
    <div class="quiz-progress">第 ${state.quiz.idx + 1} / ${state.quiz.order.length} 题　·　单元 ${u.id}: ${u.title}</div>
    <div class="quiz-hz">${q.hanzi}</div>
    <div class="quiz-en">${q.en}</div>
    <div class="quiz-opts">`;
  q.options.forEach((opt, i) => {
    html += `<div class="quiz-opt" data-opt="${opt.replace(/"/g, '&quot;')}">${opt}</div>`;
  });
  html += `</div>
    <div class="quiz-footer">
      <div class="quiz-score">本轮得分：${state.quiz.score}</div>
      <button class="btn secondary" id="nextQ" disabled>下一题</button>
    </div>
  </div>`;
  document.getElementById('main').innerHTML = html;
  state.quiz.answered = false;

  document.querySelectorAll('.quiz-opt').forEach(el => {
    el.addEventListener('click', () => {
      if (state.quiz.answered) return;
      state.quiz.answered = true;
      const chosen = el.dataset.opt;
      document.querySelectorAll('.quiz-opt').forEach(o => o.classList.add('disabled'));
      if (chosen === q.correct) {
        el.classList.add('correct');
        state.quiz.score++;
      } else {
        el.classList.add('wrong');
        document.querySelectorAll('.quiz-opt').forEach(o => {
          if (o.dataset.opt === q.correct) o.classList.add('correct');
        });
        addMistake({ hanzi: q.hanzi, correct: q.correct, en: q.en, unit: u.id, unitTitle: u.title });
      }
      document.getElementById('nextQ').disabled = false;
    });
  });
  document.getElementById('nextQ').addEventListener('click', () => {
    state.quiz.idx++;
    renderQuiz();
  });
}

function renderDialogue() {
  const u = getUnit(state.unit);
  let html = `<div class="card">
    <div class="toggle-row">
      <button class="btn secondary" id="toggleDlgPinyin">${state.showDlgPinyin ? '隐藏拼音' : '显示拼音'}</button>
    </div>`;
  u.dialogue.forEach(l => {
    if (!l.sp && !l.hz) {
      html += `<div class="dlg-line" style="text-align:center;color:#555;">${l.py || ''}</div>`;
      return;
    }
    html += `<div class="dlg-line">
      ${l.sp ? `<div class="dlg-sp">${l.sp}</div>` : ''}
      <div class="dlg-hz">${l.hz}</div>
      <div class="dlg-py ${state.showDlgPinyin ? '' : 'hidden'}">${l.py}</div>
    </div>`;
  });
  html += `</div>`;
  document.getElementById('main').innerHTML = html;
  document.getElementById('toggleDlgPinyin').addEventListener('click', () => {
    state.showDlgPinyin = !state.showDlgPinyin;
    renderDialogue();
  });
}

function renderScenario() {
  const u = getUnit(state.unit);
  if (!u.scenarios || !u.scenarios.length) {
    document.getElementById('main').innerHTML = `<div class="card"><div class="empty-state">这个单元没有场景练习</div></div>`;
    return;
  }
  if (state.scenarioIdx >= u.scenarios.length) state.scenarioIdx = 0;
  const s = u.scenarios[state.scenarioIdx];
  let html = `<div class="card">
    <div class="toggle-row" style="justify-content:space-between;">
      <div style="color:var(--muted);font-size:0.8rem;">场景 ${state.scenarioIdx + 1} / ${u.scenarios.length}</div>
      <button class="btn secondary" id="nextScenario">换一个场景 ➜</button>
    </div>
    <h2>${s.title}</h2>
    <p style="color:var(--muted);font-size:0.9rem;">${s.scenario}</p>

    <div class="sentence-counter">
      <div>
        <div style="font-size:0.75rem;color:var(--muted);">自由表达句数（目标 ≥ 8 句）</div>
        <div class="num ${state.sentenceCount >= 8 ? 'ok' : ''}">${state.sentenceCount}</div>
      </div>
      <div class="counter-btns">
        <button id="cntMinus">－</button>
        <button id="cntPlus">＋</button>
        <button id="cntReset" style="width:auto;padding:0 10px;">重置</button>
      </div>
    </div>

    <div class="scn-block">
      <h3>A 可以问 / 说：</h3>
      <ul>${s.aq.map(x => `<li>${x}</li>`).join('')}</ul>
    </div>
    <div class="scn-block">
      <h3>B 可以问 / 说：</h3>
      <ul>${s.bq.map(x => `<li>${x}</li>`).join('')}</ul>
    </div>
    <div class="scn-block">
      <h3>延伸问题（考官可能追问）：</h3>
      <ul>${s.ext.map(x => `<li>${x}</li>`).join('')}</ul>
    </div>
  </div>`;
  document.getElementById('main').innerHTML = html;
  document.getElementById('nextScenario').addEventListener('click', () => {
    state.scenarioIdx = (state.scenarioIdx + 1) % u.scenarios.length;
    state.sentenceCount = 0;
    renderScenario();
  });
  document.getElementById('cntPlus').addEventListener('click', () => { state.sentenceCount++; renderScenario(); });
  document.getElementById('cntMinus').addEventListener('click', () => { state.sentenceCount = Math.max(0, state.sentenceCount - 1); renderScenario(); });
  document.getElementById('cntReset').addEventListener('click', () => { state.sentenceCount = 0; renderScenario(); });
}

function renderMistakes() {
  const arr = loadMistakes();
  let html = `<div class="card">
    <h2>错题本 (${arr.length})</h2>`;
  if (!arr.length) {
    html += `<div class="empty-state">还没有错题，继续加油！</div>`;
  } else {
    html += arr.map((m, i) => `
      <div class="mistake-item">
        <div>
          <div style="font-size:1rem;">${m.hanzi} <span style="color:var(--accent2);">${m.correct}</span></div>
          <div style="color:var(--muted);font-size:0.78rem;">${m.en} · Unit ${m.unit} ${m.unitTitle || ''}</div>
        </div>
        <div class="x" data-idx="${i}">✕</div>
      </div>
    `).join('');
    html += `<button class="btn secondary" id="clearAll" style="margin-top:10px;">清空错题本</button>`;
  }
  html += `</div>`;
  document.getElementById('main').innerHTML = html;
  document.querySelectorAll('.mistake-item .x').forEach(el => {
    el.addEventListener('click', () => removeMistake(parseInt(el.dataset.idx)));
  });
  const clearBtn = document.getElementById('clearAll');
  if (clearBtn) clearBtn.addEventListener('click', () => { saveMistakes([]); render(); });
}

function render() {
  renderUnitTabs();
  renderModeTabs();
  if (state.mode === 'vocab') renderVocab();
  else if (state.mode === 'quiz') renderQuiz();
  else if (state.mode === 'dialogue') renderDialogue();
  else if (state.mode === 'scenario') renderScenario();
  else if (state.mode === 'mistakes') renderMistakes();
}

document.getElementById('modeTabs').addEventListener('click', (e) => {
  const t = e.target.closest('.mode-tab');
  if (!t) return;
  state.mode = t.dataset.mode;
  if (state.mode === 'quiz') resetQuiz();
  render();
});

resetQuiz();
render();
</script>
</body>
</html>
